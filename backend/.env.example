# ====================================================================
# FLOODWATCH BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and configure your environment-specific credentials
# ====================================================================

# Database Mode: 'postgresql' or 'sqlite'
DB_MODE=postgresql
ALLOW_SQLITE_FALLBACK=true

# PostgreSQL Connection Credentials
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=floodwatch

# Full Connection URL (constructed automatically if omitted)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/floodwatch
SQLITE_FALLBACK_URL=sqlite:///./floodwatch.db

# Application Security
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# IoT Telemetry Ingestion Key (Must match station firmware)
IOT_API_KEY=your_station_secret_api_key_here

# Hydrological Defaults (Bad Münstereifel, Germany)
DEFAULT_SAFE_LEVEL=2.00
DEFAULT_WARNING_LEVEL=3.00
DEFAULT_DANGER_LEVEL=4.00
RAPID_RISE_THRESHOLD_M_PER_HR=0.20
HEAVY_RAIN_THRESHOLD_MM_HR=25.0
HIGH_SOIL_MOISTURE_PERCENT=85.0
LOW_BATTERY_PERCENT=20.0
SENSOR_OFFLINE_MINUTES=15
SENSOR_TILT_THRESHOLD_DEG=15.0
DEFAULT_LATITUDE=50.5539
DEFAULT_LONGITUDE=6.7633
LOCATION_NAME="Bad Münstereifel, Germany"

# ====================================================================
# BLYNK CLOUD INTEGRATION
# ====================================================================
BLYNK_TEMPLATE_ID=TMPL3HpkNOZ7w
BLYNK_TEMPLATE_NAME=FloodWatch
BLYNK_DEVICE_NAME=FloodWatch-Station-01
BLYNK_AUTH_TOKEN=
BLYNK_SERVER_URL=https://blynk.cloud/external/api
